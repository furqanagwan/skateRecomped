#include <winver.h>

1 ICON "metadata/skate.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unofficial recompilation"
            VALUE "FileDescription", "Skate (unofficial native PC recompilation)"
            VALUE "ProductName", "Skate"
            VALUE "LegalCopyright", "Skate (c) 2007 Electronic Arts. Not affiliated with or endorsed by Electronic Arts."
            VALUE "InternalName", "skate"
            VALUE "OriginalFilename", "Skate.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
